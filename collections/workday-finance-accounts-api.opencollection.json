{
  "opencollection": "1.0.0",
  "info": {
    "name": "Workday Finance Financial Management Accounts API",
    "version": "v41.2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Financial Accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://wd2-impl-services1.workday.com/ccx/api/financial-management/v41.2/{tenant}/accounts",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip for pagination"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by account type"
              }
            ]
          },
          "docs": "Returns a collection of general ledger accounts in the tenant."
        },
        {
          "info": {
            "name": "Get Financial Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://wd2-impl-services1.workday.com/ccx/api/financial-management/v41.2/{tenant}/accounts/:accountId",
            "params": [
              {
                "name": "accountId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the account"
              }
            ]
          },
          "docs": "Returns details of a specific general ledger account."
        }
      ]
    }
  ],
  "bundled": true
}